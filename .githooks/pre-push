#!/bin/sh
# Blocks a push when Co's code-only evals fail (Royce, 2026-09-15: "Nothing
# blocks a push that breaks them"). Runs typecheck, the voice check, and every
# eval that needs no model or database, in about 10 seconds.
# Live model evals: npm --prefix api run evals:live (costs money; run before
# changing a prompt or model).
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency: git push --no-verify
if git diff --quiet HEAD @{push} -- api 2>/dev/null; then
  exit 0
fi
echo "pre-push: running Co's code-only evals..."
if ! npm --prefix api run -s evals:code > /tmp/co-evals-prepush.txt 2>&1; then
  grep -aE "FAIL|HARD|error|Error" /tmp/co-evals-prepush.txt | head -20
  echo "pre-push: evals failed; push blocked. Full output: /tmp/co-evals-prepush.txt"
  exit 1
fi
grep -aE "hard failures|passed" /tmp/co-evals-prepush.txt | tail -20
