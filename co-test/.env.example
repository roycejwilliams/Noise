# Own DB — separate from dev and prod. A fresh/empty Postgres is fine; the
# server bootstraps brew_dev's table structure (no data) on first boot.
DATABASE_URL=

# Same Hume config Co uses in production — reused as-is, not forked.
HUME_CONFIG_ID=
HUME_API_KEY=
HUME_SECRET_KEY=

# Extraction pipeline dependencies (same as api/.env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Same Twilio account and Sendblue account production uses — there is no
# separate dev number for either (confirmed: only one Twilio number exists on
# the account, and Sendblue's webhook is a single account-level setting no
# matter how many numbers it has, so a second number wouldn't isolate
# anything). Real-call and real-iMessage testing here shares these
# credentials with production and local dev.
TWILIO_ACCOUNT_SID=
TWILIO_CLIENT_SECRET=
TWILIO_LIVE_SID=
TWILIO_PHONE_NUMBER=
SENDBLUE_API_KEY=
SENDBLUE_SECRET_KEY=
SENDBLUE_PHONE_NUMBER=

# This service's own public URL — used as the Twilio status-callback target
# and printed in the phone-test page's instructions for what to point
# Sendblue's webhook and the dev Hume config's webhook at.
API_URL=https://test.copatible.com

PORT=3000
