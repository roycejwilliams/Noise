{
  "name": "co-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/client/call.ts src/client/results.ts src/client/prompt.ts src/client/phone.ts src/client/checklist.ts --bundle --outdir=public --platform=browser --format=iife --target=es2020",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/co-test/src/server.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "ai": "^6.0.191",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "hume": "^0.15.17",
    "libphonenumber-js": "^1.13.7",
    "openai": "^6.42.0",
    "pg": "^8.20.0",
    "sendblue": "^3.10.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
