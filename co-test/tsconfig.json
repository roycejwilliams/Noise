{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../api/src/services/profileExtraction.ts",
    "../api/src/db/migrations.ts",
    "../api/src/services/sendblue.ts",
    "../api/src/utils/phone.ts",
    "../api/src/otpActions.ts",
    "../api/src/types/index.d.ts",
    "../api/src/services/places.ts"
  ],
  "exclude": ["node_modules", "dist", "src/client/**/*", "src/_archive/**/*"]
}
