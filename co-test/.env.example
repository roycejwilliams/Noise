# Own DB — separate from dev and prod. A fresh/empty Postgres is fine; the
# server bootstraps brew_dev's table structure (no data) on first boot.
DATABASE_URL=

# Same Hume config Co uses in production — reused as-is, not forked.
HUME_CONFIG_ID=
HUME_API_KEY=
HUME_SECRET_KEY=
# Bearer token set on the Hume EVI config's webhook — validates that /co/webhook
# calls actually came from Hume rather than a forged request naming a
# different tester's user_id. Unset = validation is skipped (dev fallback,
# matches production's api/src/routes/co.ts) — set this for any deployment
# reachable outside your own machine.
HUME_WEBHOOK_SECRET=

# Extraction pipeline dependencies (same as api/.env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Same Twilio account and Sendblue account production uses — there is no
# separate dev number for either (confirmed: only one Twilio number exists on
# the account, and Sendblue's webhook is a single account-level setting no
# matter how many numbers it has, so a second number wouldn't isolate
# anything). Real-call and real-iMessage testing here shares these
# credentials with production and local dev.
TWILIO_ACCOUNT_SID=
TWILIO_CLIENT_SECRET=
TWILIO_LIVE_SID=
TWILIO_PHONE_NUMBER=
# Twilio's Auth Token — NOT the same value as TWILIO_CLIENT_SECRET above.
# Used only to validate the X-Twilio-Signature header on /co/call-status, so
# a spoofed status callback can't corrupt call_status for a guessed call_sid.
# Find it on the Twilio Console's account dashboard.
TWILIO_AUTH_TOKEN=
SENDBLUE_API_KEY=
SENDBLUE_SECRET_KEY=
SENDBLUE_PHONE_NUMBER=

# This service's own public URL — used as the Twilio status-callback target
# and printed in the phone-test page's instructions for what to point
# Sendblue's webhook and the dev Hume config's webhook at.
API_URL=https://test.copatible.com

# Required — gates the internal dashboard (/checklist and its supporting
# /api/checklist, /api/circles-test, /api/dynamic-test routes), which expose
# real testers' PII and can trigger a real SMS send. Not required by the
# public tester-facing phone/call flow. Share this with the team out of band
# (not in a public channel); the browser's basic-auth prompt only checks the
# password, any username works. Requests are refused (503) if this is unset.
CO_TEST_DASHBOARD_PASSWORD=

PORT=3000

# LLM call tracing (Claude call sites in profileExtraction/matching/etc.) —
# same Langfuse Cloud project api/ uses. Get keys from Settings -> API Keys
# in the Langfuse project; US cloud region shown, EU is cloud.langfuse.com.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
